# Firebase Client Configuration (Frontend)
VITE_FIREBASE_API_KEY=your_firebase_api_key
VITE_FIREBASE_AUTH_DOMAIN=your-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# Cloudinary Integration (Server & Uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=clsg_preset
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret

# AI Providers
OPENAI_API_KEY=your_openai_api_key_here
AI_PROVIDER=mock # Options: "mock" (Deterministic 100% offline) or "openai"
TTS_PROVIDER=mock # Options: "mock" (Web Speech API) or "elevenlabs"
VIDEO_PROVIDER=mock # Options: "mock" (Remotion/Manim Preview) or "remotion"

# Region OCR service (ocr_server/, VietOCR). Public URL, no secret. Unset = tesseract.js in the browser.
VITE_VIETOCR_URL=http://localhost:8765

# ---------------------------------------------------------------------------
# SERVER-ONLY secrets (Vercel → Project Settings → Environment Variables).
# NEVER prefix these with VITE_: every VITE_* variable is compiled into the
# browser bundle and becomes public.
# ---------------------------------------------------------------------------
# Shared Gemini key used by /api/llm/gemini when a user has not entered their own key
GEMINI_API_KEY=
# Optional: comma-separated origins allowed to use the shared key (e.g. https://clsg-ir-studio.vercel.app)
ALLOWED_ORIGINS=
# Langfuse telemetry, forwarded by /api/telemetry/langfuse
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
# Public (safe) Langfuse project id for deep links
VITE_LANGFUSE_PROJECT_ID=
